{
	"name": "@mariozechner/pi-channel",
	"version": "0.57.1",
	"description": "Standalone channel bridge for pi with HTTP and Socket.IO transports",
	"type": "module",
	"bin": {
		"pi-channel": "dist/main.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"examples",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/main.js",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"start:local": "node dist/main.js --pi-cli ../coding-agent/dist/cli.js .",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@mariozechner/pi-ai": "^0.57.1",
		"@mariozechner/pi-coding-agent": "^0.57.1",
		"qrcode-terminal": "^0.12.0",
		"socket.io": "^4.8.3"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@types/qrcode-terminal": "^0.12.2",
		"shx": "^0.4.0",
		"typescript": "^5.7.3"
	},
	"keywords": [
		"channel",
		"bridge",
		"socket.io",
		"webhook",
		"pi"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/badlogic/pi-mono.git",
		"directory": "packages/channel"
	},
	"engines": {
		"node": ">=20.6.0"
	}
}
